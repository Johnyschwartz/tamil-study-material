# Copy this file to ".env" and fill in your real values. Never upload .env anywhere.

# From Atlas: Connect > Drivers. Replace USER, PASSWORD and the cluster host.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER-HOST/?retryWrites=true&w=majority

# Any long random text (30+ characters)
JWT_SECRET=change-this-to-a-long-random-text

# Login for Elizabeth Rathi (username: Elizabeth Rathi)
ADMIN_PASSWORD=choose-a-strong-password

# First student password (she can change it later from the Admin tab)
STUDENT_PASSWORD=student123

# After you host the website, put its link here (example: https://yoursite.netlify.app)
ALLOWED_ORIGIN=*
